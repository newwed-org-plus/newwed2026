{
  "name": "new-wed-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@hookform/resolvers": "5.2.2",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "drizzle-orm": "0.45.2",
    "jose": "6.1.0",
    "lucide-react": "0.575.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.71.2",
    "react-server-dom-webpack": "19.3.0",
    "sonner": "2.0.7",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@cloudflare/vitest-plugin": "^1.1.9",
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "csv-parse": "7.0.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.43.0",
    "vite": "8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "4.131.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:production": "CLOUDFLARE_ENV=production vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:production": "vinext-cloudflare deploy --skip-build --config dist/server/wrangler.json",
    "db:migrate:production": "wrangler d1 migrations apply new-wed-platform-production --remote --config dist/server/wrangler.json",
    "dev:events": "wrangler dev --config wrangler.events.jsonc",
    "deploy:events": "wrangler deploy --config wrangler.events.jsonc",
    "deploy:uazapi": "wrangler deploy --config wrangler.uazapi.jsonc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:d1:wave2": "bash scripts/test-wave2-d1.sh",
    "test:d1:wave3": "bash scripts/test-wave3-d1.sh",
    "test:d1:wave4": "bash scripts/test-wave4-d1.sh",
    "test:workers": "vitest run --config vitest.worker.config.ts",
    "preflight:launch": "node scripts/preflight-launch.mjs",
    "test:visual": "playwright test tests/visual",
    "baseline:capture": "UPDATE_BASELINES=1 playwright test tests/visual/parity.spec.ts",
    "baseline:capture:target": "UPDATE_BASELINES=1 BASELINE_CAPTURE_TARGET=1 playwright test tests/visual/parity.spec.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply new-wed-platform-development --local",
    "cf:types": "wrangler types src/types/cloudflare-env.d.ts --env-file config/wrangler-types.env"
  }
}
