{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new-wed-platform",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "workers/web.ts",
  "durable_objects": { "bindings": [{ "name": "ADMIN_PASSWORD_VERIFIER", "class_name": "AdminPasswordVerifier" }] },
  "migrations": [{ "tag": "admin-password-v1", "new_sqlite_classes": ["AdminPasswordVerifier"] }],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "vars": {
    "ENVIRONMENT": "development",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ALLOW_LOCAL_ACCESS": "false",
    "OPENAI_MODEL": "gpt-5-mini",
    "ASAAS_API_URL": "https://api-sandbox.asaas.com/v3",
    "META_GRAPH_VERSION": "v23.0",
    "TURNSTILE_SITE_KEY": "",
    "META_CHECKOUT_TEMPLATE": "checkout_famtour"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "new-wed-platform-development",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "new-wed-platform-development"
    }
  ],
  "images": { "binding": "IMAGES" },
  "queues": {
    "producers": [
      { "binding": "EVENTS_QUEUE", "queue": "new-wed-events-development" }
    ]
  },
  "env": {
    "staging": {
      "durable_objects": { "bindings": [{ "name": "ADMIN_PASSWORD_VERIFIER", "class_name": "AdminPasswordVerifier" }] },
      "vars": { "ENVIRONMENT": "staging", "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "", "ALLOW_LOCAL_ACCESS": "false", "OPENAI_MODEL": "gpt-5-mini", "ASAAS_API_URL": "https://api-sandbox.asaas.com/v3", "META_GRAPH_VERSION": "v23.0", "TURNSTILE_SITE_KEY": "", "META_CHECKOUT_TEMPLATE": "checkout_famtour" },
      "d1_databases": [{ "binding": "DB", "database_name": "new-wed-platform-staging", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "new-wed-platform-staging" }],
      "queues": { "producers": [{ "binding": "EVENTS_QUEUE", "queue": "new-wed-events-staging" }] }
    },
    "production": {
      "durable_objects": { "bindings": [{ "name": "ADMIN_PASSWORD_VERIFIER", "class_name": "AdminPasswordVerifier" }] },
      "account_id": "41245f76790f4922487ec395c9e3bcec",
      "workers_dev": true,
      "routes": [
        { "pattern": "newwed.com.br/*", "zone_name": "newwed.com.br" },
        { "pattern": "www.newwed.com.br/*", "zone_name": "newwed.com.br" }
      ],
      "vars": { "ENVIRONMENT": "production", "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "", "ALLOW_LOCAL_ACCESS": "false", "OPENAI_MODEL": "gpt-5-mini", "ASAAS_API_URL": "https://api.asaas.com/v3", "META_GRAPH_VERSION": "v23.0", "TURNSTILE_SITE_KEY": "", "META_CHECKOUT_TEMPLATE": "checkout_famtour" },
      "d1_databases": [{ "binding": "DB", "database_name": "new-wed-platform-production", "database_id": "2263d378-59c9-4e5a-8d9b-a6e0140767dd", "migrations_dir": "migrations" }],
      "r2_buckets": [],
      "queues": { "producers": [{ "binding": "EVENTS_QUEUE", "queue": "new-wed-events-production" }] }
    }
  }
}
